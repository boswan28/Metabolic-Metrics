* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #111;
    background: #eef7f4;
    line-height: 1.7;
}

header {
    min-height: 75vh;
    padding: 70px 10%;
    color: white;
    background:
        linear-gradient(rgba(0, 80, 110, 0.82), rgba(32, 130, 78, 0.82)),
        url("images/harvard-healthy-plate.png");
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

header h1 {
    font-size: 4rem;
    max-width: 900px;
    margin: 0 0 20px;
    line-height: 1.05;
}

header p {
    font-size: 1.3rem;
    max-width: 750px;
}

nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: white;
    border-bottom: 3px solid #2f9e44;
    padding: 15px 8%;
    text-align: center;
}

nav a {
    color: #064663;
    text-decoration: none;
    font-weight: bold;
    margin: 0 12px;
}

nav a:hover {
    color: #2f9e44;
}

section {
    max-width: 1100px;
    margin: 45px auto;
    padding: 45px;
    background: white;
    border-radius: 18px;
    box-shadow: 0 10px 28px rgba(0,0,0,0.08);
}

h2 {
    font-size: 2.4rem;
    color: #064663;
    margin-top: 0;
    border-left: 8px solid #2f9e44;
    padding-left: 16px;
}

h3 {
    color: #2f9e44;
    margin-top: 28px;
}

p {
    font-size: 1.05rem;
}

#values,
#about {
    display: grid;
    grid-template-columns: 1fr;
}

#values h2,
#about h2 {
    grid-column: 1 / -1;
}

#values h3,
#about h3 {
    background: #eef7f4;
    padding: 18px 18px 0;
    border-radius: 14px 14px 0 0;
    margin-bottom: 0;
}

#values h3 + p,
#about h3 + p {
    background: #eef7f4;
    padding: 0 18px 18px;
    border-radius: 0 0 14px 14px;
    margin-top: 0;
}

#advocacy h3 {
    border-bottom: 2px solid #d8eee6;
    padding-bottom: 6px;
}

#media {
    background: #ffffff;
}

#media img {
    max-width: 100%;
    display: block;
    margin: 25px auto 10px;
    border-radius: 16px;
    border: 2px solid #d8eee6;
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
}

.video-container {
    width: 100%;
    max-width: 900px;
    margin: 25px auto;
}

.video-container iframe {
    width: 100%;
    height: 500px;
    border: none;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
}

ul {
    line-height: 2;
}

a {
    color: #064663;
}

footer {
    background: linear-gradient(135deg, #064663, #2f9e44);
    color: white;
    text-align: center;
    padding: 35px;
}

@media (max-width: 700px) {
    header h1 {
        font-size: 2.5rem;
    }

    section {
        padding: 28px;
        margin: 25px 12px;
    }

    .video-container iframe {
        height: 300px;
    }

    nav a {
        display: inline-block;
        margin: 6px;
    }
}
