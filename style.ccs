* {
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}

body {
margin: 0;
font-family: Arial, Helvetica, sans-serif;
background: #eef7f4;
color: #111111;
line-height: 1.7;
}

.hero {
min-height: 85vh;
display: flex;
align-items: center;
padding: 80px 10%;
color: white;
background: linear-gradient(135deg, rgba(3, 76, 102, 0.92), rgba(35, 145, 80, 0.88)), url("images/image.png");
background-size: cover;
background-position: center;
}

.hero-content {
max-width: 900px;
}

.label,
.section-label {
text-transform: uppercase;
letter-spacing: 2px;
font-weight: bold;
font-size: 0.88rem;
color: #0b7285;
}

.hero .label {
color: #d8f3dc;
}

.hero h1 {
font-size: 4.4rem;
line-height: 1.05;
margin: 15px 0;
}

.subtitle {
font-size: 1.35rem;
max-width: 780px;
}

.button {
display: inline-block;
margin-top: 22px;
padding: 13px 24px;
background: white;
color: #064663;
border-radius: 999px;
text-decoration: none;
font-weight: bold;
}

.button:hover {
background: #d8f3dc;
}

nav {
position: sticky;
top: 0;
z-index: 20;
background: white;
border-bottom: 4px solid #2f9e44;
padding: 15px 8%;
text-align: center;
box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

nav a {
color: #064663;
text-decoration: none;
font-weight: bold;
margin: 0 12px;
}

nav a:hover {
color: #2f9e44;
}

main {
max-width: 1180px;
margin: 0 auto;
padding: 30px 20px;
}

section {
background: white;
margin: 42px 0;
padding: 46px;
border-radius: 22px;
box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
}

h2 {
font-size: 2.6rem;
line-height: 1.12;
margin: 8px 0 20px;
color: #064663;
border-left: 8px solid #2f9e44;
padding-left: 18px;
}

h3 {
color: #2f9e44;
font-size: 1.35rem;
margin-top: 28px;
}

p {
font-size: 1.05rem;
}

a {
color: #064663;
}

.claim-box {
background: #eef7f4;
border-left: 8px solid #2f9e44;
padding: 26px;
border-radius: 18px;
margin: 28px 0;
}

.claim-box h3 {
margin-top: 0;
color: #064663;
}

.three-column {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 24px;
margin-top: 30px;
}

.card {
background: #f8fffc;
border: 1px solid #cce3dc;
border-radius: 18px;
padding: 26px;
box-shadow: 0 8px 22px rgba(0, 0, 0, 0.05);
}

.card h3 {
margin-top: 0;
color: #064663;
}

.media-card {
background: #f8fffc;
border: 1px solid #cce3dc;
border-radius: 20px;
padding: 28px;
margin: 30px 0;
}

.media-card h3 {
margin-top: 0;
color: #064663;
}

img {
max-width: 100%;
display: block;
margin: 24px auto 10px;
border-radius: 18px;
border: 2px solid #d8eee6;
box-shadow: 0 10px 25px rgba(0, 0, 0, 0.14);
}

.caption {
text-align: center;
font-size: 0.92rem;
color: #444444;
}

.video-container {
width: 100%;
max-width: 900px;
margin: 25px auto;
}

.video-container iframe {
width: 100%;
height: 500px;
border: none;
border-radius: 18px;
box-shadow: 0 10px 25px rgba(0, 0, 0, 0.14);
}

ul {
line-height: 2;
}

footer {
background: linear-gradient(135deg, #064663, #2f9e44);
color: white;
text-align: center;
padding: 38px 8%;
margin-top: 50px;
}

footer a {
color: white;
font-weight: bold;
}

@media (max-width: 850px) {
.hero {
padding: 60px 7%;
}

.hero h1 {
font-size: 2.8rem;
}

section {
padding: 30px;
}

.three-column {
grid-template-columns: 1fr;
}

.video-container iframe {
height: 300px;
}

nav a {
display: inline-block;
margin: 6px;
}
}
